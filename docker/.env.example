# 小皮租房线上环境配置示例
# 正式值只保存在部署目录的 .env 中，权限应设置为 600，禁止提交真实密钥。

# 后台管理与接口签名
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请填写后台强密码
JWT_ADMIN_SECRET=请填写至少32位随机字符串
CONTACT_PHONE=请填写客服电话

# 微信小程序认证
WECHAT_MINI_APP_ID=请填写小程序AppID
WECHAT_MINI_APP_SECRET=请填写小程序AppSecret
WECHAT_MOCK_ENABLED=false

# 腾讯位置服务（地址搜索与地图定位）
TENCENT_MAP_KEY=请填写腾讯位置服务Key

# MySQL 数据库
MYSQL_DATABASE=xiaopi_platform
MYSQL_USER=xiaopi_user
MYSQL_PASSWORD=请填写数据库业务账号密码
MYSQL_ROOT_PASSWORD=请填写数据库root密码
