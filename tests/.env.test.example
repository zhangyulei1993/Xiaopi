# Copy to tests/.env.test using tests/scripts/test-environment.sh init.
# The init command generates new local-only credentials; never copy production values here.
TEST_MYSQL_USER=qa_runner
TEST_MYSQL_PASSWORD=GENERATE_LOCALLY
TEST_MYSQL_ROOT_PASSWORD=GENERATE_LOCALLY
TEST_AUTH_TOKEN_SECRET=GENERATE_LOCALLY
TEST_AUTH_TOKEN_TTL=15m
TEST_BOOTSTRAP_ADMIN_PASSWORD=GENERATE_LOCALLY
TEST_WECHAT_CODE_MAP=qa-user-a=qa-user-a,qa-user-b=qa-user-b,qa-admin=qa-admin,qa-disabled=qa-disabled
