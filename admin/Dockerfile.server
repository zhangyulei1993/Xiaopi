FROM node:22-alpine AS builder
WORKDIR /app
COPY admin/package.json ./
RUN npm install --no-audit --no-fund
WORKDIR /workspace/admin
COPY admin/ ./
COPY miniapp/src/static/ /workspace/miniapp/src/static/
ARG VITE_API_BASE=https://api.xiaopizufang.cn/api
ENV VITE_API_BASE=${VITE_API_BASE}
RUN ln -s /app/node_modules node_modules && npm run build

FROM nginx:1.27-alpine
COPY admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/admin/dist /usr/share/nginx/html
EXPOSE 80

