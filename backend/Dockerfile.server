FROM golang:1.26 AS builder
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/xiaopi-api ./cmd/server

FROM debian:bookworm-slim
WORKDIR /workspace/backend
COPY --from=builder /out/xiaopi-api /usr/local/bin/xiaopi-api
EXPOSE 18080
ENTRYPOINT ["/usr/local/bin/xiaopi-api"]
